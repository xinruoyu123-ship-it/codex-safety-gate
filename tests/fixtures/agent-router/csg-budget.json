{
  "schema_version": 1,
  "enforcement": "runtime",
  "limits": {
    "max_children": 2,
    "max_concurrent": 1,
    "max_depth": 1,
    "max_sol_calls": 1,
    "max_retry_per_task": 1
  },
  "allowed_model_tiers": ["luna", "terra", "sol"],
  "benchmark": {
    "require_quality_gate": true,
    "metrics": [
      "input_tokens",
      "output_tokens",
      "reasoning_tokens",
      "agent_count",
      "call_count",
      "retry_count",
      "success",
      "latency_ms"
    ]
  }
}
